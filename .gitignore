/data/
/outputs/

# Archives (results / pool handoffs; shared directly, never committed)
*.zip

# ADA cluster scripts (machine/account-specific; kept locally, not in git)
code/scripts/*.sbatch
code/scripts/ada_*.sh
code/scripts/setup_ada.sh
code/scripts/submit.sh
code/scripts/progress.sh
code/scripts/collect_results.sh
code/scripts/make_tasks.py
code/scripts/write_manifest.py

